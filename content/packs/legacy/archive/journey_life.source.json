  "texts": {
    "name.city.west": "青川城",
    "name.west.street": "青川长街",
    "name.west.office": "官署前厅",
    "name.west.grain": "郑记粮铺",
    "name.actor.player": "行旅人",
    "name.actor.chen": "陈衡",
    "name.actor.zheng": "郑伯",
    "name.actor.apprentice": "阿成",
    "name.org.office": "西城公仓",
    "name.org.grain": "郑氏粮铺",
    "name.role.office": "公仓经办",
    "name.role.merchant": "掌柜",
    "name.role.clerk": "当值伙计",
    "name.item.grain": "粮食",
    "name.shop.grain": "郑氏粮铺货单",
    "name.notice.grain": "公仓采买告示",
    "name.offer.grain": "公仓采买",
    "office.remember": "“又见面了。”陈衡抬头认出你，手里的笔没有再放下。\n“上回的粮已经入仓。往后有合适的差事，我记着你。今天是来叙话，还是路过？”",
    "office.hello": "陈衡搁下笔，把案边一卷竹简压住。\n“从门前过来的？先坐。有事慢慢说，别被外头那些催粮的人吓着。”",
    "office.menu": "他把案上的账册往旁边挪了挪，等你开口。",
    "office.ask": "听说公仓在雇人采买？",
    "office.accept": "条款明白了，这一趟我来办。",
    "office.report": "粮已经带来，请验收。",
    "common.leave": "先不打扰，告辞。",
    "office.terms": "“公仓缺十份粮。六百五十钱先支给你，从办妥受领算起，八个半日内送到这里。\n按约余款归你，另付八十钱。来回脚程自己算好，别只盯着哪家便宜。”",
    "office.done": "“经费和凭据都齐了。先办事，不必急着答谢。\n交粮仍来这张案前找我；路上有变故，也回来把缘由讲清楚。”",
    "office.unavailable": "陈衡重新看了看凭据。\n“眼下还办不成，先核清缺的是什么。是粮数、经费，还是该来的人不在？事情没谈妥前，不会动你的钱。”",
    "dialog.shop.hello": "郑伯从粮袋里捻起几粒谷，摊在手心给你看。\n“先看成色，再谈钱。自家吃，还是替人采买？”",
    "dialog.shop.menu": "柜台上放着木斗和一摞旧账。郑伯示意你慢慢挑。",
    "dialog.shop.goods": "请掌柜把货单给我看看。",
    "dialog.shop.leave": "我再看看，先告辞。",
    "dialog.shop.done": "“账清了。”郑伯朝阿成点点头。\n“把袋口扎牢，别到半路漏了。下次来，看准铺门上那只旧木斗就认得路。”",
    "dialog.shop.error": "“没谈妥的买卖不算。”郑伯合上账本，没有动柜台上的货。",
    "dialog.clerk.hello": "阿成把一袋粮靠墙放稳，抹了把汗。\n“掌柜就在那边。寻常买卖我也能办，只是赊账、举荐这些事，得问他老人家。”",
    "dialog.clerk.menu": "阿成站在粮袋旁，等着装货。",
    "dialog.clerk.goods": "先看看你这里的货。",
    "dialog.clerk.leave": "你忙，我先走了。",
    "dialog.clerk.done": "“数目都核过了。要是带去公仓，记得让那边当面点清。”",
    "dialog.clerk.error": "“这一笔还没成，货还在铺里。您再核一遍？”",
    "name.scenario.procurement": "官署采购验收",
    "name.west.tavern": "桥头酒肆",
    "name.village.east": "东里",
    "name.east.entrance": "东里村口",
    "name.east.home": "何家小院",
    "name.actor.shen": "沈安",
    "name.actor.he": "何氏",
    "name.role.sender": "写信的人",
    "name.role.recipient": "收信人",
    "name.item.family_letter": "家书",
    "name.offer.letter": "送达家书",
    "letter.hello": "沈安把封好的信在指间转了半圈，又放回桌上。\n“客官是往东走的人么？别误会，不是请你替我跑官府——只是家里一封信。”",
    "letter.menu": "窗外有人收起空酒坛。沈安压低了声音。",
    "letter.details": "这信要送给谁？",
    "letter.accept": "我会亲手交给她，再回来回话。",
    "letter.report": "信已亲手交到何氏手里。",
    "letter.leave": "容我想想，先告辞。",
    "letter.terms": "“送到东里的何家，交何氏本人。她手上有旧伤，话不多，你别认错人。\n十六个半日内回来报个平安，我付一百二十钱。信没交到她手里，别算送到了。”",
    "letter.done": "沈安把信交给你，手却迟了半拍才松开。\n“封口不要拆。她看过便好。路上稳当些，我在这儿等你的回话。”",
    "letter.unavailable": "沈安看着你，没有伸手拿钱。\n“先把事情问清楚。信在谁手里、交给了谁，总要说得准。”",
    "recipient.hello": "何氏在门里应了一声，并没有马上打开院门。\n“从青川来？你找哪一位？”",
    "recipient.menu": "门开了一道缝，她在等你说明来意。",
    "recipient.deliver": "沈安托我给您一封家书。",
    "recipient.leave": "打扰了，我先告辞。",
    "recipient.done": "何氏辨过封口，终于把信接过去。\n“让他少挂心。我这儿一切照旧。你也歇歇脚再走，村口的井水是干净的。”",
    "recipient.error": "这封信现在不能交到我手里。",
    "recipient.none": "“今日没有托你捎带的东西。既然路过，走累了便在院外歇一歇。”",
    "name.event.letter": "酒肆里的托付",
    "name.scenario.two_stories": "采购与送信共存",
    "name.scenario.lived_city": "初到青川",
    "office.reported": "陈衡验过粮数，在册上落下一笔。\n“十份，不差。你答应的事做到了。余款依约留下，这八十钱也是你该得的。”",
    "letter.reported": "沈安听完，先松了一口气，才想起去摸钱袋。\n“她收下了就好。多谢你跑这一趟。这份报酬说好的，一钱不少。”",
    "letter.remember": "“信的事，多亏了你。”沈安把旁边的凳子拉开。\n“这回不托你跑腿了，坐一会儿罢。她肯收信，我心里那块石头也落了地。”",
    "flavour.west.street": "车轮碾过石缝，门口的酒旗轻轻晃着。城里的人各忙着自己的事。",
    "flavour.west.office": "案上的账册还没合拢。门吏在边上听来意，办事的人在案后等回话。",
    "flavour.west.grain": "谷香混着麻袋的气味。掌柜核价，伙计装货，谁也没闲着。",
    "flavour.west.tavern": "酒还温着，窗边有人一遍遍捋平信封。另一桌的车夫正在说路上的见闻。",
    "flavour.west.inn": "门帘挡住了街上的尘土。店家留着一盏灯，等赶路人歇脚。",
    "flavour.east.home": "院里的草席晾得半干，门后传来一声应答。",
    "flavour.east.entrance": "树荫遮着村口。何家的院门在前面，来人看得到、也走得进去。",
    "office.budget.ask": "办妥后，余款怎样处理？",
    "office.budget": "“这份是包干的约。办妥后，合约允许的结余归你；办不妥便得把未用的公款和公粮交回。\n不是每份差事都这样，接前看清，省得回来扯不明白。”",
    "name.actor.gate": "周平",
    "name.role.gate": "门吏",
    "dialog.gate.hello": "“别站在门风里，往里挪一步。”周平朝案后示意。\n“陈主事在。公仓的事归他，找人、问路先问我。”",
    "dialog.gate.directions.ask": "我第一次来，这里怎样办事？",
    "dialog.gate.directions.answer": "“那边贴着告示，先看明白。领经费找陈主事，回来交粮也找他。\n内堂不必去，十份粮还用不着跑三间屋子。”",
    "dialog.gate.town.ask": "城里哪里可以落脚？",
    "dialog.gate.town.answer": "“西街有粮铺，桥边有酒肆。想睡个囫囵觉，去客舍找吴掌柜。\n认准人，问明价，旁人的便宜话别急着信。”",
    "dialog.gate.menu": "你想说些什么？",
    "dialog.gate.denied": "“眼下办不成。先看看人手和钱物，不能让你白等，也不能算一笔糊涂账。”",
    "name.actor.host": "柳娘",
    "name.role.host": "酒肆店家",
    "dialog.host.hello": "柳娘把温着的酒壶放回炉边，抬眼看你。\n“坐哪儿都成，窗边那张桌子有人候信，别把他的信压湿了。”",
    "dialog.host.people.ask": "那位客人有什么心事？",
    "dialog.host.people.answer": "“沈安在等一封回话。他没喝多少，倒把信拿出来看了好几回。\n真想帮他，自己过去问。我可不能替他把家事说完。”",
    "dialog.host.work.ask": "店里缺不缺帮手？",
    "dialog.host.work.answer": "柳娘点清八十钱，推到你面前。\n“桌椅拾掇得利落。工钱说好了，拿着。日后有空，再来坐坐。”",
    "dialog.host.road.ask": "听车夫说，往东的路怎样？",
    "dialog.host.road.answer": "“车把式就在那张桌边。走过路的是他，问他比听我转述稳当。\n何家若要捎信，记着交本人。”",
    "dialog.host.menu": "你想说些什么？",
    "dialog.host.denied": "“眼下办不成。先看看人手和钱物，不能让你白等，也不能算一笔糊涂账。”",
    "name.actor.carter": "老邱",
    "name.role.carter": "车夫",
    "dialog.carter.hello": "老邱拍了拍鞋底的干泥。\n“他们只会说东路近。近是近，装粮时袋口不扎牢，再近也一路漏。”",
    "dialog.carter.road.ask": "我正打算往东里去。",
    "dialog.carter.road.answer": "“从街口出城，沿东路走就到村口。何家院子挨着小路，不用绕进田里。\n我说的是刚走过的路，可不是保你明日风雨都不变。”",
    "dialog.carter.life.ask": "你天天都走这一趟？",
    "dialog.carter.life.answer": "“有货才走。前些日子没活，我把车轴拆了又安。\n世道好不好，车轮最先知道。今日能把一车东西安稳送到，就算好日子。”",
    "dialog.carter.menu": "你想说些什么？",
    "dialog.carter.denied": "“眼下办不成。先看看人手和钱物，不能让你白等，也不能算一笔糊涂账。”",
    "name.west.inn": "青川客舍",
    "name.actor.innkeeper": "吴掌柜",
    "name.role.inn": "客舍店家",
    "dialog.inn.hello": "吴掌柜用布掸了掸柜台。\n“赶路累了罢？二十钱，歇半日。屋里干净，行囊放在手边，醒了再动身。”",
    "dialog.inn.rest.ask": "付二十钱，歇半日。",
    "dialog.inn.rest.answer": "推开窗时，街上的声音又清楚起来。\n吴掌柜在楼下招呼：“醒了？急事再多，也得留点精神走路。”",
    "dialog.inn.town.ask": "这里住的都是些什么人？",
    "dialog.inn.town.answer": "“有商人，有跑腿的，也有只想躲一夜雨的。客人的姓名我不随便讲。\n你若寻人，先说清来由，我替你问一句。”",
    "dialog.inn.menu": "你想说些什么？",
    "dialog.inn.denied": "“眼下办不成。先看看人手和钱物，不能让你白等，也不能算一笔糊涂账。”",
    "dialog.host.remember": "“又来了？上回那些桌椅，是你帮着拾掇的。”\n柳娘抬手招呼你进来：“这回不用站在门口说明来意，先坐。”",
    "companion.carter.ask": "一道走一程，如何？",
    "companion.carter.familiar": "老邱把包袱往身边挪了挪。「同行的约定还算数，歇好了便走。还有什么想问的？」",
    "companion.carter.terms": "「可以一道走。路上的吃用劳你照应，停下来歇脚时不算路费。到了安全的地方，你我再商量分开。」他伸出手，等你把约定确认。",
    "companion.carter.joined": "「那便说定了。」老邱提起包袱，站到了你身边。",
    "companion.carter.declined": "老邱点点头。「不急，出门的事，想清楚再说。」",
    "name.actor.walker": "许成",
    "name.role.walker": "行路商旅",
    "walker.hello": "对面的旅人收住脚步，扶了扶肩上的包袱。「在下许成，常在青川和东里之间走动。借个道，别碰着你的行李。」",
    "walker.menu": "许成看看前路，等你开口。",
    "walker.ask": "常走这条路吗？",
    "walker.answer": "「往返有些年头了。走得快不如走得稳，遇见同行人，问一句总比闷头赶路强。」"
  },
