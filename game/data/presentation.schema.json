        },
        "target_ref": {
          "$ref": "#/$defs/scene_target_ref"
        },
        "visible_if": {
          "$ref": "#/$defs/scene_visible_if"
        },
        "extent": {
          "$ref": "#/$defs/percent"
        }
      },
      "anyOf": [
        {
          "required": [
            "profile_id"
          ]
        },
        {
          "required": [
            "target_ref"
          ]
        }
      ]
    },
    "hotspot_layer": {
      "type": "object",
      "required": [
        "id",
        "kind",
