      "additionalProperties": false,
      "description": "原家庭、原群体、原义务与唯一供养绑定共享同一私粮容器。"
    },
    "dynamic_household_provisioning": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "authorizations": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 65536,
          "additionalProperties": {
            "$ref": "#/$defs/dynamic_household_provision_authorization"
