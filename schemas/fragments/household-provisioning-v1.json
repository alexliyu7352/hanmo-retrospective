{
  "format": "hanmo.schema.fragment/1",
  "version": "household_provisioning/1",
  "status": "central registration pending; authoring-only fragment",
  "$defs": {
    "dynamic_household_provision_authorization": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/entity_id"
        },
        "household_group_id": {
          "$ref": "#/$defs/entity_id"
        },
        "cohort_id": {
          "$ref": "#/$defs/entity_id"
        },
        "obligation_id": {
          "$ref": "#/$defs/entity_id"
        },
        "provision_binding_id": {
          "$ref": "#/$defs/entity_id"
        },
        "inventory_id": {
          "$ref": "#/$defs/entity_id"
        },
        "item_id": {
          "$ref": "#/$defs/reference_items"
        },
        "rate_profile_id": {
          "$ref": "#/$defs/entity_id"
        }
      },
      "required": [
        "id",
        "household_group_id",
        "cohort_id",
        "obligation_id",
        "provision_binding_id",
        "inventory_id",
        "item_id",
        "rate_profile_id"
