# 命名门只运行已经构建的存读专属二进制，不嵌套启动旧整树目标。
foreach(required HANMO_CHECKLIST_BINARY HANMO_CHECKLIST_PREPARED HANMO_CHECKLIST_ROW HANMO_CHECKLIST_OUTPUT HANMO_CHECKLIST_AUTHOR_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Storage checklist input missing: ${required}")
    endif()
endforeach()
if(NOT EXISTS "${HANMO_CHECKLIST_BINARY}" OR NOT EXISTS "${HANMO_CHECKLIST_PREPARED}")
    message(FATAL_ERROR "Build the actual storage checklist target and retain the shared configuration first")
endif()
if(NOT IS_ABSOLUTE "${HANMO_CHECKLIST_AUTHOR_ROOT}" OR NOT IS_DIRECTORY "${HANMO_CHECKLIST_AUTHOR_ROOT}")
    message(FATAL_ERROR "An explicit absolute actual author resource directory is required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
set(base "${HANMO_CHECKLIST_OUTPUT}/${stamp}")
set(output "${base}")
set(index 0)
while(EXISTS "${output}" OR EXISTS "${output}.prepared.json")
    math(EXPR index "${index}+1")
    set(output "${base}-${index}")
endwhile()
message(STATUS "Actual storage evidence: ${output}")
# 每轮只采样一次真实输入原字节，避免其它领域之后合法添加数据影响冷进程对照。
# 这是本轮运行输入，不修改唯一共用配置，也不重算或替换其中任何身份字段。
get_filename_component(evidence_parent "${output}" DIRECTORY)
file(MAKE_DIRECTORY "${evidence_parent}")
configure_file("${HANMO_CHECKLIST_PREPARED}" "${output}.prepared.json" COPYONLY)
set(HANMO_CHECKLIST_PREPARED "${output}.prepared.json")
if(HANMO_CHECKLIST_ROW STREQUAL "K9_3")
    if(NOT EXISTS "${HANMO_CHECKLIST_SECOND_PREPARED}")
        message(FATAL_ERROR "The one original second configuration is missing")
    endif()
    configure_file("${HANMO_CHECKLIST_SECOND_PREPARED}" "${output}.second-prepared.json" COPYONLY)
    set(HANMO_CHECKLIST_SECOND_PREPARED "${output}.second-prepared.json")
    execute_process(COMMAND "${HANMO_CHECKLIST_BINARY}" K9-3-INPUTS
        "${HANMO_CHECKLIST_PREPARED}" "${HANMO_CHECKLIST_SECOND_PREPARED}"
        "${HANMO_CHECKLIST_AUTHOR_ROOT}"
        RESULT_VARIABLE distinct)
    if(NOT distinct EQUAL 0)
        message(FATAL_ERROR "Two real distinct configurations required: ${distinct}")
    endif()
    foreach(config first second)
        if(config STREQUAL "first")
            set(prepared "${HANMO_CHECKLIST_PREPARED}")
        else()
            set(prepared "${HANMO_CHECKLIST_SECOND_PREPARED}")
        endif()
        foreach(mode K9-3-PRODUCE K9-3-CONSUME)
            execute_process(COMMAND "${HANMO_CHECKLIST_BINARY}" "${mode}"
                "${prepared}" "${output}/${config}" "${HANMO_CHECKLIST_AUTHOR_ROOT}"
                RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "${config}/${mode} failed at actual interface: ${result}; retained ${output}")
            endif()
        endforeach()
    endforeach()
elseif(HANMO_CHECKLIST_ROW STREQUAL "K9_2" OR HANMO_CHECKLIST_ROW STREQUAL "K9_4"
        OR HANMO_CHECKLIST_ROW STREQUAL "K9_1_PENDING"
        OR HANMO_CHECKLIST_ROW STREQUAL "K9_1_CARGO")
    if(HANMO_CHECKLIST_ROW STREQUAL "K9_2")
        set(modes SLOT2-PRODUCE SLOT2-CONSUME)
    elseif(HANMO_CHECKLIST_ROW STREQUAL "K9_4")
        set(modes K9-4-PRODUCE K9-4-CONSUME)
    elseif(HANMO_CHECKLIST_ROW STREQUAL "K9_1_CARGO")
        set(modes K9-1-CARGO-PRODUCE K9-1-CARGO-CONSUME)
    else()
        set(modes K9-1-PENDING-PRODUCE K9-1-PENDING-CONSUME)
    endif()
    foreach(mode IN LISTS modes)
        execute_process(COMMAND "${HANMO_CHECKLIST_BINARY}" "${mode}"
            "${HANMO_CHECKLIST_PREPARED}" "${output}" "${HANMO_CHECKLIST_AUTHOR_ROOT}"
            RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${mode} failed at actual storage interface: ${result}; retained ${output}")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "No completed storage scenario for original row ${HANMO_CHECKLIST_ROW}")
endif()
