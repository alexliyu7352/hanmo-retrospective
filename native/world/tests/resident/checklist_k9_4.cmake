# 原 K9-4 的两个真实进程，保留各轮 worker、旧回调与原银行证据。
foreach(required HANMO_BUILD_DIR HANMO_CHECKLIST_BINARY HANMO_CHECKLIST_PREPARED)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Required Slot/2 input missing: ${required}")
    endif()
endforeach()
if(NOT EXISTS "${HANMO_CHECKLIST_PREPARED}")
    message(FATAL_ERROR "Selected shared-world prepared file is missing")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${HANMO_BUILD_DIR}"
    --target test_resident_checklist_shared_world --parallel 1 RESULT_VARIABLE built)
if(NOT built EQUAL 0)
    message(FATAL_ERROR "Actual common consumer build failed: ${built}")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
set(base "${HANMO_BUILD_DIR}/native-checklist/checklist_K9_4/${stamp}")
set(output "${base}")
set(index 0)
while(EXISTS "${output}")
    math(EXPR index "${index}+1")
    set(output "${base}-${index}")
endwhile()
message(STATUS "Real Slot/2 evidence directory: ${output}")
foreach(mode K9-4-PRODUCE K9-4-CONSUME)
    execute_process(COMMAND "${HANMO_CHECKLIST_BINARY}" "${mode}"
        "${HANMO_CHECKLIST_PREPARED}" "${output}" 0 RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} failed; original evidence retained: ${output}; code=${result}")
    endif()
endforeach()
