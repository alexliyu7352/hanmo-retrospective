# Finite source integration checks, invoked by the existing resident configure.
# No new build target, test, compiler invocation or CI job is introduced here.
# This source check is deliberately not a proof of permission, business-source
# closure, hot memory accounting, semantic correctness or runtime admission.
set(_hanmo_shared_registry "${CMAKE_CURRENT_SOURCE_DIR}/contracts/resident_shared_execution.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_hanmo_shared_registry}")
file(READ "${_hanmo_shared_registry}" _hanmo_shared_json)
string(JSON _hanmo_shared_schema GET "${_hanmo_shared_json}" schema_version)
if(NOT _hanmo_shared_schema EQUAL 1)
    message(FATAL_ERROR "Unsupported shared-execution interface registry")
endif()
string(JSON _hanmo_shared_count LENGTH "${_hanmo_shared_json}" entries)
if(_hanmo_shared_count LESS 1)
    message(FATAL_ERROR "Shared-execution interface registry is empty")
endif()
math(EXPR _hanmo_shared_last "${_hanmo_shared_count}-1")
get_target_property(_hanmo_shared_target_sources hanmo_resident SOURCES)

# Actual retired implementation files cannot silently return through a target
# list or an unregistered resident source. Historical freezes live outside src.
string(JSON _hanmo_retired_count LENGTH "${_hanmo_shared_json}" retired_source_paths)
if(_hanmo_retired_count GREATER 0)
    math(EXPR _hanmo_retired_last "${_hanmo_retired_count}-1")
    foreach(_r RANGE ${_hanmo_retired_last})
        string(JSON _retired GET "${_hanmo_shared_json}" retired_source_paths ${_r} path)
        if(NOT _retired MATCHES "^src/resident/[A-Za-z_0-9/]+[.]cpp$")
            message(FATAL_ERROR "Invalid retired shared-source path")
        endif()
        list(FIND _hanmo_shared_target_sources "${_retired}" _retired_target)
        list(FIND HANMO_RESIDENT_IDENTITY_FILES "${_retired}" _retired_identity)
        if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${_retired}" OR
           NOT _retired_target LESS 0 OR NOT _retired_identity LESS 0)
            message(FATAL_ERROR "Retired shared implementation must be removed: ${_retired}")
        endif()
    endforeach()
endif()


# Include all actual resident implementation/header files, not just the known
# callers: a second definition of a registered entry cannot hide in a new leaf.
# Only files containing a registered symbol are retained in the search text.
set(_hanmo_shared_candidates "")
foreach(_i RANGE ${_hanmo_shared_last})
    string(JSON _n LENGTH "${_hanmo_shared_json}" entries ${_i} symbols)
    if(_n LESS 1)
        message(FATAL_ERROR "Shared-execution entry lacks an owned definition")
    endif()
    math(EXPR _last "${_n}-1")
    foreach(_s RANGE ${_last})
        string(JSON _symbol GET "${_hanmo_shared_json}" entries ${_i} symbols ${_s} name)
        if(NOT _symbol MATCHES "^[A-Za-z_][A-Za-z_0-9]*$")
            message(FATAL_ERROR "Invalid finite shared-execution symbol")
        endif()
        if(_hanmo_shared_candidates STREQUAL "")
            set(_hanmo_shared_candidates "${_symbol}")
        else()
            string(APPEND _hanmo_shared_candidates "|${_symbol}")
        endif()
    endforeach()
endforeach()
file(GLOB_RECURSE _hanmo_shared_files CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/resident/*.cpp"
    "${CMAKE_CURRENT_SOURCE_DIR}/src/resident/*.hpp")
# 领域拆分片段仍属于真实源码；只补显式身份清单，不扩大目录扫描。
foreach(_path IN LISTS HANMO_RESIDENT_IDENTITY_FILES)
    if(_path MATCHES "[.]inc$")
        list(APPEND _hanmo_shared_files "${CMAKE_CURRENT_SOURCE_DIR}/${_path}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _hanmo_shared_files)
set(_hanmo_shared_source_text "")
foreach(_path IN LISTS _hanmo_shared_files)
    file(READ "${_path}" _text)
    if(_text MATCHES "${_hanmo_shared_candidates}")
        # Remove comments so a commented-out old call cannot satisfy this gate.
        # This is a finite source pattern check, not a C++ parser.
        string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" " " _text "${_text}")
        string(REGEX REPLACE "//[^\r\n]*" " " _text "${_text}")
        string(APPEND _hanmo_shared_source_text "\n${_text}\n")
    endif()
endforeach()

function(_hanmo_shared_require_registered path)
    if(path MATCHES "\\.cpp$")
        list(FIND _hanmo_shared_target_sources "${path}" _found)
    else()
        list(FIND HANMO_RESIDENT_IDENTITY_FILES "${path}" _found)
    endif()
    if(_found LESS 0)
        message(FATAL_ERROR "Shared original owner/consumer is not registered: ${path}")
    endif()
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${path}")
        message(FATAL_ERROR "Missing shared original owner/consumer: ${path}")
    endif()
endfunction()

# 消费者按原翻译单元核调用；展开已登记的领域片段，拒绝缺登记或循环包含。
# 不展开普通头文件，也不把其他翻译单元的调用并入本消费者。
function(_hanmo_shared_read_consumer path output)
    list(FIND ARGN "${path}" _cycle)
    if(NOT _cycle LESS 0)
        message(FATAL_ERROR "Cyclic shared consumer fragment: ${path}")
    endif()
    _hanmo_shared_require_registered("${path}")
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${path}" _consumer_text)
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" " " _consumer_text "${_consumer_text}")
    string(REGEX REPLACE "//[^\r\n]*" " " _consumer_text "${_consumer_text}")
    string(REGEX MATCHALL "(^|[\r\n])[ \t]*#[ \t]*include[ \t]*\"[^\"\r\n]+[.]inc\""
        _fragment_includes "${_consumer_text}")
    get_filename_component(_consumer_dir "${CMAKE_CURRENT_SOURCE_DIR}/${path}" DIRECTORY)
    foreach(_include IN LISTS _fragment_includes)
        string(REGEX REPLACE "^[\r\n \t]*#[ \t]*include[ \t]*\"([^\"]+)\"$" "\\1"
            _fragment "${_include}")
        get_filename_component(_absolute "${_fragment}" ABSOLUTE BASE_DIR "${_consumer_dir}")
        if(NOT EXISTS "${_absolute}")
            # 与原 hanmo_resident 的 src 包含根一致，兼容 resident/... 具名片段。
            get_filename_component(_absolute "${_fragment}" ABSOLUTE
                BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src")
        endif()
        file(RELATIVE_PATH _relative "${CMAKE_CURRENT_SOURCE_DIR}" "${_absolute}")
        _hanmo_shared_read_consumer("${_relative}" _fragment_text ${ARGN} "${path}")
        string(APPEND _consumer_text "\n${_fragment_text}\n")
    endforeach()
    set(${output} "${_consumer_text}" PARENT_SCOPE)
endfunction()

foreach(_i RANGE ${_hanmo_shared_last})
    string(JSON _id GET "${_hanmo_shared_json}" entries ${_i} id)
    string(JSON _owner GET "${_hanmo_shared_json}" entries ${_i} implementation)
    string(JSON _header GET "${_hanmo_shared_json}" entries ${_i} header)
    _hanmo_shared_require_registered("${_owner}")
    _hanmo_shared_require_registered("${_header}")
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${_owner}" _owner_text)
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" " " _owner_text "${_owner_text}")
    string(REGEX REPLACE "//[^\r\n]*" " " _owner_text "${_owner_text}")
    string(JSON _n LENGTH "${_hanmo_shared_json}" entries ${_i} symbols)
    math(EXPR _last "${_n}-1")
    foreach(_s RANGE ${_last})
        string(JSON _symbol GET "${_hanmo_shared_json}" entries ${_i} symbols ${_s} name)
        string(JSON _pattern GET "${_hanmo_shared_json}" entries ${_i} symbols ${_s} definition_regex)
        string(REGEX MATCHALL "${_pattern}" _owner_matches "${_owner_text}")
        list(LENGTH _owner_matches _owner_count)
        string(REGEX MATCHALL "${_pattern}" _all_matches "${_hanmo_shared_source_text}")
        list(LENGTH _all_matches _all_count)
        if(NOT _owner_count EQUAL 1 OR NOT _all_count EQUAL 1)
            message(FATAL_ERROR "${_id}: ${_symbol} must have exactly one definition at ${_owner}; owner=${_owner_count}, tree=${_all_count}")
        endif()
    endforeach()
    string(JSON _n LENGTH "${_hanmo_shared_json}" entries ${_i} consumers)
    if(_n LESS 2)
        message(FATAL_ERROR "${_id}: at least two concrete consumers are required")
    endif()
    math(EXPR _last "${_n}-1")
    set(_consumer_paths "")
    foreach(_c RANGE ${_last})
        string(JSON _consumer GET "${_hanmo_shared_json}" entries ${_i} consumers ${_c} path)
        _hanmo_shared_require_registered("${_consumer}")
        list(APPEND _consumer_paths "${_consumer}")
        _hanmo_shared_read_consumer("${_consumer}" _text)
        string(JSON _calls LENGTH "${_hanmo_shared_json}" entries ${_i} consumers ${_c} required_call_regexes)
        if(_calls LESS 1)
            message(FATAL_ERROR "${_id}: missing actual call constraint for ${_consumer}")
        endif()
        math(EXPR _call_last "${_calls}-1")
        foreach(_call RANGE ${_call_last})
            string(JSON _pattern GET "${_hanmo_shared_json}" entries ${_i} consumers ${_c} required_call_regexes ${_call})
            if(NOT _text MATCHES "${_pattern}")
                message(FATAL_ERROR "${_id}: original shared call missing in ${_consumer}; contact registered owner")
            endif()
        endforeach()
        string(JSON _forbidden LENGTH "${_hanmo_shared_json}" entries ${_i} consumers ${_c} forbidden_regexes)
        if(_forbidden GREATER 0)
            math(EXPR _forbidden_last "${_forbidden}-1")
            foreach(_f RANGE ${_forbidden_last})
                string(JSON _pattern GET "${_hanmo_shared_json}" entries ${_i} consumers ${_c} forbidden_regexes ${_f})
                if(_text MATCHES "${_pattern}")
                    message(FATAL_ERROR "${_id}: retired duplicate write/formula returned in ${_consumer}")
                endif()
            endforeach()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _consumer_paths)
    list(LENGTH _consumer_paths _unique_consumers)
    if(_unique_consumers LESS 2)
        message(FATAL_ERROR "${_id}: repeated entries do not provide two actual consumers")
    endif()
endforeach()
