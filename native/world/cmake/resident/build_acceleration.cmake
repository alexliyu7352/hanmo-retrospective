# 下一完整源码批显式启用；默认不改变历史目标、编译命令或源身份。
option(HANMO_ENABLE_CCACHE "使用已核专用 ccache 启动器；缺配置则拒绝" OFF)
option(HANMO_ENABLE_PCH "为同一 resident CXX 目标建立私有 PCH" OFF)
option(HANMO_CCACHE_PCH_GUARDED "显式同意严格时间宏拒门与逐PCH真实身份策略" OFF)
option(HANMO_BUILD_ACCELERATION_N1_PHASED "由新N1 caller按真实PCH前序生成不可变profile" OFF)
if(HANMO_ENABLE_CCACHE AND HANMO_BUILD_ACCELERATION_N1_PHASED)
    if(NOT COMMAND cmake_file_api)
        message(FATAL_ERROR "当前严格新运行需要CMake 3.27+实际toolchains回复")
    endif()
    # 同次真实configure的隐式搜索根证据，不另运行编译探针或猜默认路径。
    cmake_file_api(QUERY API_VERSION 1 TOOLCHAINS 1)
endif()
if(HANMO_ENABLE_CCACHE AND HANMO_ENABLE_PCH AND NOT HANMO_CCACHE_PCH_GUARDED)
    message(FATAL_ERROR "strict ccache 不支持静默PCH bypass；共用必须显式选guarded策略")
endif()
set(HANMO_BUILD_ACCELERATION_PROFILE "" CACHE FILEPATH "下一次运行已冻结启动器 profile")
set(HANMO_BUILD_ACCELERATION_PROFILE_SHA256 "" CACHE STRING "已冻结 profile 的 SHA256")
set(HANMO_CCACHE_EXECUTABLE "" CACHE FILEPATH "已核官方 ccache 的绝对路径，不自动下载")
if(HANMO_ENABLE_PCH)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        message(FATAL_ERROR "本批PCH/cache严格协议只实现实际GCC，不猜其他compiler规则")
    endif()
    if(NOT TARGET hanmo_resident)
        message(FATAL_ERROR "PCH 只能用于已实际登记的 hanmo_resident")
    endif()
    # PRIVATE 且没有 REUSE_FROM：每个目标独立保其真实语言、宏和 flags。
    target_precompile_headers(hanmo_resident PRIVATE
        "$<$<COMPILE_LANGUAGE:CXX>:${CMAKE_CURRENT_SOURCE_DIR}/src/resident/pch/resident_common.hpp>")
    set_property(TARGET hanmo_resident PROPERTY PCH_WARN_INVALID ON)
    # GCC使用PCH时-MD也必须包含创建PCH的全部头，不能只留下.gch路径。
    target_compile_options(hanmo_resident PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:-fpch-deps>")
    if(HANMO_RESIDENT_TEST_FAULTS)
        # 两个已有 source-specific 宏不能借另一宏环境的 PCH。
        set_source_files_properties(src/resident/kernel/resident_world.cpp
            src/resident/kernel/boundary_dispatch.cpp PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
    endif()
endif()
if(HANMO_ENABLE_CCACHE)
    if(NOT IS_ABSOLUTE "${HANMO_CCACHE_EXECUTABLE}" OR NOT EXISTS "${HANMO_CCACHE_EXECUTABLE}")
        message(FATAL_ERROR "必须先取得并核验显式 ccache；本规则不安装工具")
    endif()
    if(NOT HANMO_BUILD_ACCELERATION_N1_PHASED)
    if(NOT EXISTS "${HANMO_BUILD_ACCELERATION_PROFILE}")
        message(FATAL_ERROR "ccache 必须绑定当前运行冻结 profile，不能使用全局隐式配置")
    endif()
    file(SHA256 "${HANMO_BUILD_ACCELERATION_PROFILE}" hanmo_actual_profile_sha)
    if(NOT hanmo_actual_profile_sha STREQUAL HANMO_BUILD_ACCELERATION_PROFILE_SHA256)
        message(FATAL_ERROR "构建加速 profile 身份不符")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    # 真实编译数据库仍保存 compiler argv；N1 新 caller 单独绑定这个 launcher，不假装数据库含它。
    set(hanmo_launcher "${Python3_EXECUTABLE};${CMAKE_CURRENT_SOURCE_DIR}/../../tools/native/build_acceleration.py;--profile;${HANMO_BUILD_ACCELERATION_PROFILE};--sha256;${HANMO_BUILD_ACCELERATION_PROFILE_SHA256};--")
    endif()
    get_property(hanmo_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(hanmo_target IN LISTS hanmo_targets)
        get_target_property(hanmo_type ${hanmo_target} TYPE)
        if(hanmo_type STREQUAL "STATIC_LIBRARY" OR hanmo_type STREQUAL "SHARED_LIBRARY" OR hanmo_type STREQUAL "EXECUTABLE" OR hanmo_type STREQUAL "OBJECT_LIBRARY")
            if(HANMO_CCACHE_PCH_GUARDED AND hanmo_target STREQUAL "hanmo_resident")
                # system headers也不可掩盖时间宏；非PCH动作采用独立strict profile。
                target_compile_options(${hanmo_target} BEFORE PRIVATE
                    "$<$<COMPILE_LANGUAGE:CXX>:-include;${CMAKE_CURRENT_SOURCE_DIR}/src/resident/pch/volatile_macro_guard.hpp;-Werror=date-time;-Wsystem-headers;-Werror=invalid-pch>")
            endif()
            if(NOT HANMO_BUILD_ACCELERATION_N1_PHASED)
                set_property(TARGET ${hanmo_target} PROPERTY C_COMPILER_LAUNCHER "${hanmo_launcher}")
                set_property(TARGET ${hanmo_target} PROPERTY CXX_COMPILER_LAUNCHER "${hanmo_launcher}")
            else()
                # 真CMake argv不塞未生成的PCH使用profile；新caller必须逐动作真实外包ccache。
                set_property(TARGET ${hanmo_target} PROPERTY HANMO_REQUIRES_FROZEN_N1_CCACHE_LAUNCHER TRUE)
            endif()
        endif()
    endforeach()
endif()
