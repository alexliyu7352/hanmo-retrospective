foreach(path IN LISTS HANMO_RESIDENT_IDENTITY_FILES)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${path}")
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${path}" sha)
    string(APPEND resident_identity "${path}:${sha}\n")
endforeach()
string(SHA256 HANMO_RESIDENT_SOURCE_SHA "${resident_identity}")
